POSTGRES_USER=leaderboard
POSTGRES_PASSWORD=leaderboard_dev_password
POSTGRES_DB=leaderboard
APP_ENV=development
DATABASE_URL=postgresql+psycopg://leaderboard:leaderboard_dev_password@postgres:5432/leaderboard
REDIS_URL=redis://redis:6379/0
APP_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
STORAGE_ROOT=/data/submissions
QUEUE_NAME=evaluation_jobs
MALWARE_SCANNER=disabled
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SHOW_MOCK_EVALUATION=true

# ACCESS_TOKEN_EXPIRE_MINUTES applies to admins only; students have no token/session.
# CORS_ORIGINS must match the frontend origin (localhost and 127.0.0.1 differ).
# Run Alembic upgrade head before API startup; never migrate the original DB without backup.
